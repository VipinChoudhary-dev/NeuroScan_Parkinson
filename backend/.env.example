# Server-only. Never use a VITE_ prefix for credentials.
GEMINI_API_KEY=
# gemini = Google AI Studio; vertex = Vertex AI Express Mode
GEMINI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated browser origins for a separately hosted frontend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
